# System DB (bdcat_system) — read/write
DATABASE_URL="mysql://bdcat:bdcat_local@127.0.0.1:3306/bdcat_system"

# Knowledge DB (stt_electorals) — READ ONLY, never migrate
KNOWLEDGE_DATABASE_URL="mysql://bdcat:bdcat_local@127.0.0.1:3306/stt_electorals"

# MySQL root used only by scripts/create-system-db.mjs
MYSQL_ROOT_PASSWORD=bdcat_root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:5173

# Seed admin
SEED_ADMIN_EMAIL=admin@bdcat.local
SEED_ADMIN_PASSWORD=bdcat-admin-change-me
SEED_ADMIN_NAME=BDCAT Admin

# OPS66 gate (SHA-256 hex of password; same default as legacy bdcat)
OPS66_PASSWORD_SHA256=59a4dfaa1a79b8ad4491f2ac7605ef65dae2d8d506d989e3923565f7fd0e8ba3

# Electoral images (member photos, party logos) — bundled under assets/electorals/img
# Override only if you keep assets elsewhere:
# ELECTORALS_ASSETS_ROOT=/absolute/path/to/electorals/img
ELECTORALS_ASSETS_ROOT=

# Voter enrichment (call centre / WhatsApp blast)
# CALLSTORE_AUDIO_BASE=https://callstore.smarttechtank.com/storage
# XBLASTER_STORAGE_BASE=https://xblasterz.smarttechtank.com/storage
