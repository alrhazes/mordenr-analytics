# System DB (Docker mysql service)
MYSQL_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-root-strong

# Knowledge DB (host MySQL — read-only user on stt_electorals)
KNOWLEDGE_MYSQL_PASSWORD=change-me-knowledge-strong

# Prisma / API (compose overrides DATABASE_URL and KNOWLEDGE_DATABASE_URL)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=https://sentra.warforge.red

# Seed admin (first deploy only — set SEED_ON_DEPLOY=true in deploy.sh)
SEED_ADMIN_EMAIL=admin@sentra.com
SEED_ADMIN_PASSWORD=change-me-after-first-login
SEED_ADMIN_NAME=SENTRA Admin

# OPS66 gate (SHA-256 hex of password)
OPS66_PASSWORD_SHA256=59a4dfaa1a79b8ad4491f2ac7605ef65dae2d8d506d989e3923565f7fd0e8ba3

# Optional: simulation AI analysis
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
