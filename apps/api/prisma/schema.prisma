generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum SimulationMode {
  BATCH
  AUTO
  INDIVIDUAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  savedViews   SavedView[]
  simulations  Simulation[]
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model SavedView {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  configJson  String   @db.Text
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Simulation {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  mode            SimulationMode @default(BATCH)
  area            String         @default("NEGARA")
  areaName        String?
  areaType        String
  mapCode         String?
  selectedCodes   String         @db.Text
  gainlossJson    String         @db.Text
  transferJson    String         @db.Text
  groupingJson    String?        @db.Text
  partyConfigJson String?        @db.Text
  partyChangeJson String?        @db.Text
  resultJson      String?        @db.Text
  chartJson       String?        @db.Text
  lastActivity    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, mode, lastActivity])
}
