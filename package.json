{
  "name": "bdcat-analytics",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "mysql2": "^3.14.2"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @bdcat/web",
    "dev:api": "npm run dev -w @bdcat/api",
    "build": "npm run build --workspaces --if-present",
    "db:create": "node scripts/create-system-db.mjs",
    "db:migrate": "npm run db:migrate -w @bdcat/api",
    "db:seed": "npm run db:seed -w @bdcat/api",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "assets:sync-electorals": "node scripts/sync-electorals-assets.mjs"
  }
}
